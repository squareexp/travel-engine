# Commit SHA published by GitHub Actions, or latest for the newest successful main build.
IMAGE_TAG=latest

# Required Twende server configuration. Copy the values from the secure server/.env.
DATABASE_URL=
DIRECT_URL=
JWT_SECRET=
JWT_REFRESH_SECRET=
PISTONI_API_URL=http://host.docker.internal:1010

# Optional integrations.
SERVER_PORT=8090
SERVER_HOST=127.0.0.1
RUST_LOG=info
REDIS_URL=redis://host.docker.internal:6379
GOOGLE_MAPS_API_KEY=
PAYMENTS_WEBHOOK_SECRET=
BASE_IDP_ISSUER=https://authlayer.squareexp.com
BASE_IDP_CLIENT_ID=
BASE_IDP_CLIENT_SECRET=
BASE_IDP_AUDIENCE=TravelEngine
BASE_IDP_MOBILE_REDIRECT_URI=partners://auth/callback
