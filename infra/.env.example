# Local Docker services only. These are development placeholders, never production credentials.
POSTGRES_USER=twende
POSTGRES_PASSWORD=twende_dev_password
POSTGRES_DB=twende
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=twende_minio
MINIO_ROOT_PASSWORD=twende_minio_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=twende-assets

# Application configuration consumed by server/.env in local development.
DATABASE_URL=postgres://twende:twende_dev_password@localhost:5432/twende
DIRECT_URL=postgres://twende:twende_dev_password@localhost:5432/twende
REDIS_URL=redis://localhost:6379
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=twende_minio
MINIO_SECRET_KEY=twende_minio_dev_password
MINIO_BUCKET=twende-assets
JWT_SECRET=replace-with-a-random-32-character-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-32-character-secret
GOOGLE_MAPS_API_KEY=replace-with-a-restricted-development-key
PISTONI_API_URL=http://localhost:1010
